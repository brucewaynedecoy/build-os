    {
      "id": "status-fresh",
      "description": "status and next on a fresh queue (every source pending)",
      "base": "library",
      "steps": [
        {
          "run": [
            "status"
          ]
        },
        {
          "run": [
            "next"
          ]
        },
        {
          "run": [
            "next",
            "--count",
            "3"
          ]
        },
        {
          "run": [
            "next",
            "--stage",
            "review"
          ]
        }
      ]
    },
